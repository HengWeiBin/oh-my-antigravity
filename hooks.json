{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(write_to_file|replace_file_content|multi_replace_file_content)$",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/K20879/.gemini/config/plugins/oh-my-openagent/scripts/pre_tool_use.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^invoke_subagent$",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/K20879/.gemini/config/plugins/oh-my-openagent/scripts/post_tool_use.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
